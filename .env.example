# MovieServer Configuration Template
# Copy this file to .env and customize with your settings

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Admin login credentials for web interface
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# JWT secret for token authentication (change in production!)
JWT_SECRET=your_jwt_secret_key_256_bit_minimum

# =============================================================================
# RABBITMQ MESSAGE QUEUE
# =============================================================================

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=movieuser
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
# =============================================================================
# SERVICE PORTS
# =============================================================================

# Frontend React application
FRONTEND_PORT=3000

# Backend ASP.NET Core API
BACKEND_PORT=5000

# Transcoding Node.js service
TRANSCODING_PORT=3001

# RabbitMQ message queue
RABBITMQ_PORT=5672

# RabbitMQ management interface
RABBITMQ_MANAGEMENT_PORT=15672

# =============================================================================
# MOVIE STORAGE
# =============================================================================

# Path to your movie collection (relative to project root)
MOVIE_FOLDER=./movies

# =============================================================================
# TRANSCODING SETTINGS
# =============================================================================

# FFmpeg preset (ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow)
FFMPEG_PRESET=veryfast

# Video quality (0-51, lower = better quality, higher file size)
TRANSCODING_QUALITY=23

# Maximum concurrent transcoding processes
MAX_CONCURRENT_TRANSCODES=2

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================

# Application environment
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Logging level (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information

# =============================================================================
# PERFORMANCE & LIMITS
# =============================================================================

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=5000

# =============================================================================
# NETWORK & CORS
# =============================================================================

# Allowed origins for CORS (comma-separated)
# Use * for development, specific domains for production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL for the server (for external access)
# PUBLIC_URL=https://your-domain.com

# =============================================================================
# ADVANCED SETTINGS (Optional)
# =============================================================================

# Database connection string (if using database features)
# DATABASE_CONNECTION_STRING=

# Redis connection string (if using caching)
# REDIS_CONNECTION_STRING=

# External storage settings (if using cloud storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# Process monitoring interval in seconds
PROCESS_MONITOR_INTERVAL=60

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development features (set to false in production)
DEVELOPMENT_MODE=false

# Enable detailed error messages (set to false in production)
DETAILED_ERRORS=false

# Enable Swagger API documentation (set to false in production)
ENABLE_SWAGGER=true
