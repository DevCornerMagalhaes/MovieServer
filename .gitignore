# =============================================================================
# MovieServer - .gitignore
# =============================================================================

# Environment variables (contains passwords and secrets)
.env

# Movie files (large binary files)
movies/
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm

# =============================================================================
# .NET / C#
# =============================================================================

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
.vscode/settings.json

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# =============================================================================
# Node.js
# =============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# ESLint cache
.eslintcache

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.local
.env.development.local
.env.test.local
.env.production.local

# =============================================================================
# React
# =============================================================================

# Production build
build/
dist/

# Cache
.cache/

# =============================================================================
# Docker
# =============================================================================

# Docker volumes
docker-volumes/

# =============================================================================
# Operating System
# =============================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# =============================================================================
# IDE & Editor
# =============================================================================

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains
.idea/
*.swp
*.swo

# Vim
*.swp
*.swo
*.tmp

# =============================================================================
# Logs and temporary files
# =============================================================================

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
.tmp/

# Backup files
*.backup
*.bak
*.orig

# =============================================================================
# Security and secrets
# =============================================================================

# JWT secrets
*.pem
*.key
*.crt
*.p12
*.pfx

# Database files (if any)
*.db
*.sqlite
*.sqlite3

# =============================================================================
# Development tools
# =============================================================================

# Coverage reports
coverage/
*.coverage
*.coveragexml

# Test results
test-results/
TestResults/

# =============================================================================
# Project specific
# =============================================================================

# FFmpeg binaries (if included)
ffmpeg/
ffprobe/

# Transcoded files cache
transcoded/
cache/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
